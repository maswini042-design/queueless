# ==============================================================================
# QueueLess — Smart Queue Prediction System Configuration
# ==============================================================================

# MongoDB Connection Configuration (Java Backend & Tomcat Environment)
# Local MongoDB Server:
MONGODB_URI="mongodb://localhost:27017"

# Or MongoDB Atlas Connection String:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"

# Target Database Name (Default: queueless_db)
MONGODB_DATABASE="queueless_db"

# Server Port (Tomcat default is 8080; AI Studio local Vite dev is 3000)
PORT="8080"

# Optional Gemini AI API Key for advanced analytics insights (if enabled)
GEMINI_API_KEY=""

# Host URL
APP_URL="http://localhost:8080/queueless"
